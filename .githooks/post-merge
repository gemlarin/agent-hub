#!/bin/sh
# Regenerate .cursor/agents when Subagents/ change (Cursor integration; skipped if Cursor not detected).
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

CHANGED="$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD 2>/dev/null || true)"
echo "$CHANGED" | grep -q '^Agents/Subagents/' || exit 0

if [ -x "./Agents/Setup/scripts/install-cursor-integration.sh" ]; then
  ./Agents/Setup/scripts/install-cursor-integration.sh
fi
