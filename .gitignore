# Monorepo workspace: only version the shared agent hub files below.
# Root AGENTS.md is the user's (ignored). Hub: README.md, Agents/AGENTS.md
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Agents/
!/.cursor/
!/.cursor/README.md
!/.cursor/agents/
!/.cursor/rules/
!/.cursor/hooks/
!/.cursor/hooks.json
# Runtime hook state (coordinator active markers)
.cursor/hooks/state/*
!.cursor/hooks/state/.gitkeep
!/.githooks/

# Safety net: never commit a hub-root MEMORY.md (path is in hub-setup.local.md)
/MEMORY.md

# Per-machine hub remotes & accounts (template: Agents/Setup/hub-setup.local.example.md)
/Agents/Setup/hub-setup.local.md

# Personal job-board list (template: Agents/Skills/job-search/boards.local.example.md)
/Agents/Skills/job-search/boards.local.md

# Per-machine rule overrides (template: user-config.example.md in each Rules folder)
/Agents/Rules/**/user-config.md

# Per-machine skill overrides (template: user-config.example.md in each skill folder)
/Agents/Skills/**/user-config.md

# Per-machine subagent overrides (template: user-config.example.md in each specialist folder)
/Agents/Subagents/**/user-config.md
