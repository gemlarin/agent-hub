{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "/usr/bin/python3 .cursor/hooks/git-delegation-hook.py"
      }
    ],
    "preToolUse": [
      {
        "command": "/usr/bin/python3 .cursor/hooks/git-delegation-hook.py",
        "matcher": "Task|CallDynamicTool"
      }
    ],
    "postToolUse": [
      {
        "command": "/usr/bin/python3 .cursor/hooks/git-delegation-hook.py",
        "matcher": "Task|CallDynamicTool"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "/usr/bin/python3 .cursor/hooks/git-delegation-hook.py",
        "matcher": "Task|CallDynamicTool"
      }
    ],
    "subagentStart": [
      {
        "command": "/usr/bin/python3 .cursor/hooks/git-delegation-hook.py"
      }
    ],
    "subagentStop": [
      {
        "command": "/usr/bin/python3 .cursor/hooks/git-delegation-hook.py"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "/usr/bin/python3 .cursor/hooks/git-delegation-hook.py",
        "matcher": "(^|[\\s;&|])(git|gh)(\\s|$)",
        "failClosed": true
      }
    ]
  }
}
