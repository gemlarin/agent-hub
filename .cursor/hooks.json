{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/git-delegation-hook.cmd"
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/git-delegation-hook.cmd",
        "matcher": "Task|CallDynamicTool"
      }
    ],
    "subagentStart": [
      {
        "command": ".cursor/hooks/git-delegation-hook.cmd"
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/git-delegation-hook.cmd"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/git-delegation-hook.cmd",
        "matcher": "(^|[\\s;&|/\\\\])(git|gh)(\\.exe)?(\\s|$)",
        "failClosed": false
      }
    ]
  }
}
